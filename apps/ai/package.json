    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "@training/contracts": "workspace:*",
    "hono": "^4.13.16",
    "langchain": "^1.6.2",
    "langsmith": "^0.11.8",
    "pg": "^8.23.1",
    "resend": "^6.38.0",
